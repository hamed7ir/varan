<!DOCTYPE overlay [
<!ENTITY % brandDTD SYSTEM "chrome://branding/locale/brand.dtd">
%brandDTD;
<!ENTITY % tabsDTD SYSTEM "chrome://browser/locale/preferences/tabs.dtd">
%tabsDTD;
]>

<overlay id="TabsPaneOverlay"
         xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">

  <prefpane id="paneTabs"
            onpaneload="gTabsPane.init();"
            helpTopic="prefs-tabs">

    <preferences id="tabsPreferences">
      <preference id="browser.link.open_newwindow"     name="browser.link.open_newwindow"     type="int"/>
      <preference id="browser.tabs.autoHide"           name="browser.tabs.autoHide"           type="bool" inverted="true"/>
      <preference id="browser.tabs.loadInBackground"   name="browser.tabs.loadInBackground"   type="bool" inverted="true"/>
      <preference id="browser.tabs.warnOnClose"        name="browser.tabs.warnOnClose"        type="bool"
                  onchange="gTabsPane.syncWarnOnClose();"/>
      <preference id="browser.tabs.warnOnCloseOtherTabs" name="browser.tabs.warnOnCloseOtherTabs" type="bool"/>
      <preference id="browser.tabs.warnOnOpen"         name="browser.tabs.warnOnOpen"         type="bool"/>
      <preference id="browser.sessionstore.restore_on_demand" name="browser.sessionstore.restore_on_demand" type="bool"/>
#ifdef XP_WIN
      <preference id="browser.taskbar.previews.enable" name="browser.taskbar.previews.enable" type="bool"/>
#endif
      <preference id="browser.tabs.insertRelatedAfterCurrent"  name="browser.tabs.insertRelatedAfterCurrent"  type="bool"/>
      <preference id="browser.search.context.loadInBackground" name="browser.search.context.loadInBackground" type="bool" inverted="true"/>
      <preference id="browser.tabs.closeWindowWithLastTab"     name="browser.tabs.closeWindowWithLastTab"     type="bool"/>
      <preference id="browser.ctrlTab.previews"                name="browser.ctrlTab.previews"                type="bool"/>
      
      <!-- Varan: bottom chrome layout -->
      <preference id="browser.varan.layout.tabsAtBottom"   name="browser.varan.layout.tabsAtBottom"   type="bool"/>
      <preference id="browser.varan.layout.navbarAtBottom" name="browser.varan.layout.navbarAtBottom" type="bool"/>
      <preference id="browser.varan.layout.bookmarksAtBottom" name="browser.varan.layout.bookmarksAtBottom" type="bool"/>
      <preference id="browser.varan.layout.hideBookmarksBar"  name="browser.varan.layout.hideBookmarksBar"  type="bool"/>
      <preference id="browser.varan.accent.chrome"   name="browser.varan.accent.chrome"   type="bool"/>
      <preference id="browser.varan.accent.tabs"     name="browser.varan.accent.tabs"     type="bool"/>
      <preference id="browser.varan.accent.useDwm"   name="browser.varan.accent.useDwm"   type="bool"/>

      <preference id="browser.newtab.url"    name="browser.newtab.url"    type="string"/>
      <preference id="browser.newtab.myhome" name="browser.newtab.myhome" type="string"/>
      <preference id="browser.newtab.choice" name="browser.newtab.choice" type="int"/>
    </preferences>
    
    <script type="application/javascript" src="chrome://browser/content/preferences/tabs.js"/>

    <!-- XXX flex below is a hack because wrapping checkboxes don't reflow
             properly; see bug 349098 -->
<!-- Varan: SCROLLABLE. Adding the layout/accent groups pushed the lower options
     out of reach.
     ⚠️ ALL THREE properties are needed and the first version shipped only two:
       overflow-y   - produces the scrollbar
       min-height:0 - stops a XUL box claiming its intrinsic minimum height
       height       - an EXPLICIT height, not max-height, and NO flex="1".
     ⚠️ `flex="1"` + `max-height` rendered the pane COMPLETELY EMPTY: a XUL box
     is not a CSS block, its flex resolution ran against the max and resolved the
     height to zero. An explicit height with no flex is the XUL idiom for a
     fixed-size scrolling container, and it is what gives overflow something to
     scroll against.
     26em fits the device's 768px-tall display with the tab strip, buttons and
     window chrome around it. -->
    <vbox id="tabPrefsBox" align="start"
          style="overflow-y: auto; overflow-x: hidden; height: 26em;">
      <checkbox id="linkTargeting" label="&newWindowsAsTabs.label;"
                accesskey="&newWindowsAsTabs.accesskey;"
                preference="browser.link.open_newwindow"
                onsyncfrompreference="return gTabsPane.readLinkTarget();"
                onsynctopreference="return gTabsPane.writeLinkTarget();"/>
      <checkbox id="warnCloseMultiple" label="&warnCloseMultipleTabs.label;"
                accesskey="&warnCloseMultipleTabs.accesskey;"
                preference="browser.tabs.warnOnClose"/>
      <checkbox id="warnOpenMany" label="&warnOpenManyTabs.label;"
                accesskey="&warnOpenManyTabs.accesskey;"
                preference="browser.tabs.warnOnOpen"/>
      <checkbox id="showTabBar" label="&showTabBar.label;"
                accesskey="&showTabBar.accesskey;"
                preference="browser.tabs.autoHide"/>
      <checkbox id="restoreOnDemand" label="&restoreTabsOnDemand.label;"
                accesskey="&restoreTabsOnDemand.accesskey;"
                preference="browser.sessionstore.restore_on_demand"/>
      <checkbox id="switchToNewTabs" label="&switchToNewTabs.label;"
                accesskey="&switchToNewTabs.accesskey;"
                preference="browser.tabs.loadInBackground"/>
#ifdef XP_WIN
      <checkbox id="showTabsInTaskbar" label="&showTabsInTaskbar.label;"
                accesskey="&showTabsInTaskbar.accesskey;"
                preference="browser.taskbar.previews.enable"/>
#endif
<!-- Pale Moon additions -->
      <checkbox id="insertRelatedAfterCurrent" label="&insertRelatedAfterCurrent.label;"
                preference="browser.tabs.insertRelatedAfterCurrent"/>
      <checkbox id="contextLoadInBackground" label="&contextLoadInBackground.label;"
                preference="browser.search.context.loadInBackground"/>
      <checkbox id="closeWindowWithLastTab" label="&closeWindowWithLastTab.label;"
                preference="browser.tabs.closeWindowWithLastTab"/>
      <checkbox id="showTabPreviews" label="&showTabPreviews.label;"
                preference="browser.ctrlTab.previews"/>
<!-- Varan additions: bottom chrome layout.
     Grouped with a restart notice, mirroring the Hardware Acceleration group in
     advanced.xul, because the placement is applied while a browser window is
     being built. Changing it affects newly opened windows; existing ones keep
     the layout they were created with, so "restart" is the honest instruction
     rather than a live reflow this cannot deliver. -->
      <groupbox id="varanLayoutGroup" align="start">
        <caption label="&varanLayout.label;"/>
        <label>&varanLayoutRestartRequired.label;</label>
        <checkbox id="varanTabsAtBottom" label="&varanTabsAtBottom.label;"
                  accesskey="&varanTabsAtBottom.accesskey;"
                  preference="browser.varan.layout.tabsAtBottom"/>
        <checkbox id="varanNavbarAtBottom" label="&varanNavbarAtBottom.label;"
                  accesskey="&varanNavbarAtBottom.accesskey;"
                  preference="browser.varan.layout.navbarAtBottom"/>
        <checkbox id="varanBookmarksAtBottom" label="&varanBookmarksAtBottom.label;"
                  preference="browser.varan.layout.bookmarksAtBottom"/>
        <checkbox id="varanHideBookmarksBar" label="&varanHideBookmarksBar.label;"
                  preference="browser.varan.layout.hideBookmarksBar"/>
      </groupbox>

      <groupbox id="varanAccentGroup" align="start">
        <caption label="&varanAccent.label;"/>
        <label>&varanLayoutRestartRequired.label;</label>
        <checkbox id="varanAccentChrome" label="&varanAccentChrome.label;"
                  preference="browser.varan.accent.chrome"/>
        <checkbox id="varanAccentTabs" label="&varanAccentTabs.label;"
                  preference="browser.varan.accent.tabs"/>
        <checkbox id="varanAccentUseDwm" label="&varanAccentUseDwm.label;"
                  preference="browser.varan.accent.useDwm"/>
      </groupbox>

      <hbox align="center">
        <label value="&newtabPage.label;"/>
        <menulist 
          id="newtabPage"
          preference="browser.newtab.choice"
          oncommand="gNewtabUrl.writeNewtabUrl(event.target.value); gTabsPane.syncNewtabCustom();">
          <menupopup>
            <!-- Varan: was hidden="true". Upstream only ever REFLECTED a custom
                 browser.newtab.url set from about:config; it could not be chosen,
                 and choosing it gave a blank page because nothing supplies a URL.
                 Now selectable, with the input field below. -->
            <menuitem label="&newtabPage.custom.label;"    value="0" id="newtabPageCustom" />
            <menuitem label="&newtabPage.blank.label;"     value="1" />
            <menuitem label="&newtabPage.home.label;"      value="2" />
            <menuitem label="&newtabPage.myhome.label;"    value="3" />
            <menuitem label="&newtabPage.quickdial.label;" value="4" />
          </menupopup>
        </menulist>
      </hbox>

      <!-- Varan: the missing half of "A custom URL". Shown only for that choice,
           bound straight to browser.newtab.url (what the page actually opens), so
           there is no second copy of the value that can drift. -->
      <hbox align="center" id="newtabCustomBox" hidden="true">
        <label control="newtabCustomUrl" value="&newtabPage.custom.url.label;"/>
        <textbox id="newtabCustomUrl" flex="1" type="url"
                 preference="browser.newtab.url"/>
      </hbox>
    </vbox>

  </prefpane>

</overlay>
